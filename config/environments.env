# ==============================================================================
# Environment Configuration Variables for Deployment & Automation (TIBCO BWCE & Datadog)
# ==============================================================================
OCP_CLUSTER_DEV_NAME="ocp-dev"
OCP_CLUSTER_STAGING_NAME="ocp-staging"
OCP_CLUSTER_PROD_NAME="ocp-prod"

OCP_APPS_DOMAIN="apps.ocp-dev.nubenetes.internal"
OCP_JENKINS_NAMESPACE="jenkins"
OCP_ARGOCD_NAMESPACE="argocd"
OCP_OBSERVABILITY_NAMESPACE="observability"

# Pinned Versions
JENKINS_HELM_VERSION="5.8.31"
JENKINS_IMAGE_TAG="2.492.2-lts-jdk21"
ARGOCD_HELM_VERSION="7.8.2"
ARGOCD_APP_VERSION="v3.5.0"
DATADOG_HELM_VERSION="3.90.0"
DATADOG_AGENT_TAG="7.58.0"
BWCE_BASE_IMAGE="tibco/bwce:2.9.2"

# Datadog Platform Settings
DATADOG_SITE="datadoghq.eu"
DATADOG_API_KEY="${DATADOG_API_KEY:-00000000000000000000000000000000}"
DATADOG_APP_KEY="${DATADOG_APP_KEY:-0000000000000000000000000000000000000000}"

# Repositories
GIT_ORG="nubenetes"
GLOBAL_VARS_REPO_URL="https://github.com/nubenetes/jenkins-git-parameter-bwce-global-vars.git"
GLOBAL_VARS_DEFAULT_BRANCH="main"
APP_SAMPLE_REPO_URL="https://github.com/nubenetes/tibco-bwce-order-service.git"
JENKINS_SHARED_LIB_REPO_URL="https://github.com/nubenetes/jenkins-git-parameter-bwce.git"
